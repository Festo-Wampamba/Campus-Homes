{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@campushomes/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@campushomes/api",
        "dev"
      ],
      "port": 4000,
      "env": {
        "RESEND_API_KEY": ""
      }
    }
  ]
}
