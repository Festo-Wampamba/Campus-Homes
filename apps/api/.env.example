# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://campushomes:campushomes_dev@localhost:54328/campushomes_dev
# In Neon staging/production, use the same restricted role as DATABASE_URL but
# select "Direct connection" (the hostname must not contain "-pooler").
AUTH_DATABASE_URL=
REDIS_URL=redis://localhost:6379
# Development always prefers this local no-eviction Redis over REDIS_URL.
DEV_REDIS_URL=redis://localhost:6379
# Self-hosted Logto. Register both applications with the web-origin callback
# /api/auth/logto/callback and post-logout URL /sign-in.
LOGTO_ENDPOINT=https://auth.example.com
LOGTO_CONSUMER_APP_ID=
LOGTO_CONSUMER_APP_SECRET=
LOGTO_STAFF_APP_ID=
LOGTO_STAFF_APP_SECRET=
# Management API machine-to-machine app used by profile/operations workflows.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
# Generate at least 32 random characters. This encrypts single-use OIDC
# transactions stored in Redis and must be different in each environment.
LOGTO_COOKIE_SECRET=
# Keep false until the deployed Logto version, staff organization policy, and
# signed auth_time/amr=mfa claims pass staging acceptance. Privileged sign-in
# fails closed while false.
LOGTO_MFA_POLICY_VERIFIED=false
# Independent bearer secrets for Logto's CampusHomes SMS/email connectors.
LOGTO_SMS_WEBHOOK_SECRET=
LOGTO_EMAIL_WEBHOOK_SECRET=
# Google OAuth is configured as a Logto connector for each environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Transactional auth email (Resend)
RESEND_API_KEY=
AUTH_EMAIL_FROM=CampusHomes <hello@campushomes.ug>
# Student inquiry notifications (comma-separated inboxes). Unset = stored only.
SUPPORT_NOTIFY_EMAILS=
AUTH_APP_URL=http://localhost:3000
# Keep blank for the normal same-origin web proxy. Only set when a reviewed
# deployment intentionally requires a shared sibling-subdomain cookie.
AUTH_COOKIE_DOMAIN=
SUPER_ADMIN_EMAIL=festo@campushomes.com
SUPER_ADMIN_PASSWORD=
PAYMENTS_ENABLED=false
# Only affects local/staging fallback adapters. Never use this to expose a
# fake checkout publicly; PAYMENTS_ENABLED remains the authoritative gate.
ALLOW_STUB_INTEGRATIONS=false
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_REDIRECT_URL=http://localhost:3000/reservations
WEB_ORIGIN=http://localhost:3000
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
CLOUDINARY_URL=
SENTRY_DSN=
POWER_BI_PUSH_URL=
POWER_BI_API_TOKEN=
PORT=4000
